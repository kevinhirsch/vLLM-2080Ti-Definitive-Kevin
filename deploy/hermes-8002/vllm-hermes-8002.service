After=network-online.target

[Service]
Type=simple
User=kevin
EnvironmentFile=/home/kevin/.local/share/vllm-qwen27b/vllm-qwen27b.env
ExecStart=/home/kevin/.local/share/vllm-qwen27b/serve-hermes-8002.sh
