{
  "id": "agentic_chain_006",
  "category": "agentic_chain",
  "description": "create ticket then assign it, answer references the returned ticket id",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "create_ticket",
        "description": "Open a support ticket.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Optional priority"
            }
          },
          "required": [
            "title",
            "description"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "assign_ticket",
        "description": "Assign a ticket to a team.",
        "parameters": {
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": "string"
            },
            "assignee": {
              "type": "string"
            }
          },
          "required": [
            "ticket_id",
            "assignee"
          ]
        }
      }
    }
  ],
  "user": "Open a ticket titled 'VPN down' and assign it to the support team.",
  "steps": [
    {
      "expect_tool": "create_ticket",
      "arg_checks": [
        {
          "path": "title",
          "match": "contains",
          "value": "VPN down"
        }
      ],
      "inject_result": {
        "ticket_id": "T-4521"
      },
      "max_tokens": 300
    },
    {
      "expect_tool": "assign_ticket",
      "arg_checks": [
        {
          "path": "ticket_id",
          "match": "exact",
          "value_from_previous_result": "ticket_id"
        }
      ],
      "inject_result": {
        "status": "assigned"
      },
      "max_tokens": 300
    },
    {
      "final": true,
      "answer_check": {
        "pattern": "T-4521",
        "must_not_pattern": "\\b(not|n't|unable|fail(ed|s)?|couldn't|cannot|can't|never|didn't|wasn't|isn't|error|sorry|unfortunately)\\b"
      },
      "max_tokens": 150
    }
  ]
}
