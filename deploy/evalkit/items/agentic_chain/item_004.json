{
  "id": "agentic_chain_004",
  "category": "agentic_chain",
  "description": "weather -> unit conversion using retrieved temperature",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "City name"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "convert_temp",
        "description": "Convert a temperature value between units.",
        "parameters": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "from_unit": {
              "type": "string",
              "enum": [
                "C",
                "F"
              ]
            },
            "to_unit": {
              "type": "string",
              "enum": [
                "C",
                "F"
              ]
            }
          },
          "required": [
            "value",
            "from_unit",
            "to_unit"
          ]
        }
      }
    }
  ],
  "user": "What's the temperature in Chicago right now, in Celsius?",
  "steps": [
    {
      "expect_tool": "get_weather",
      "arg_checks": [
        {
          "path": "city",
          "match": "regex",
          "pattern": "(?i)chicago"
        }
      ],
      "inject_result": {
        "temp_f": 41,
        "condition": "windy"
      },
      "max_tokens": 300
    },
    {
      "expect_tool": "convert_temp",
      "arg_checks": [
        {
          "path": "value",
          "match": "numeric",
          "value_from_previous_result": "temp_f"
        },
        {
          "path": "to_unit",
          "match": "exact",
          "value": "C"
        }
      ],
      "inject_result": {
        "result_c": 5.0
      },
      "max_tokens": 300
    },
    {
      "final": true,
      "answer_check": {
        "pattern": "5(\\.0)?\\s*(°|deg)?\\s*C",
        "must_not_pattern": "\\b(not|n't|unable|fail(ed|s)?|couldn't|cannot|can't|never|didn't|wasn't|isn't|error|sorry|unfortunately)\\b"
      },
      "max_tokens": 150
    }
  ]
}
