{
  "id": "json_schema_001",
  "category": "json_schema",
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "Return a JSON object describing a person with exactly these fields: name (non-empty string), age (integer between 0 and 120), email (string containing an '@'), tags (array of at least 1 string). Respond with ONLY the JSON object, no other text."
      }
    ],
    "response_format": {
      "type": "json_object"
    },
    "max_tokens": 400
  },
  "check": {
    "type": "json_schema",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "age",
        "email",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "email": {
          "type": "string",
          "pattern": "@"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
