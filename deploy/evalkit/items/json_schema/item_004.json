{
  "id": "json_schema_004",
  "category": "json_schema",
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "Return a JSON object describing a calendar event with exactly these fields: title (non-empty string), start_time (string in 'YYYY-MM-DD HH:MM' format), attendees (array of at least 1 string), is_recurring (boolean). Respond with ONLY the JSON object, no other text."
      }
    ],
    "response_format": {
      "type": "json_object"
    },
    "max_tokens": 400
  },
  "check": {
    "type": "json_schema",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "start_time",
        "attendees",
        "is_recurring"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
        },
        "attendees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "is_recurring": {
          "type": "boolean"
        }
      }
    }
  }
}
