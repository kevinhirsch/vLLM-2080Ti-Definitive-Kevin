{
  "id": "json_schema_006",
  "category": "json_schema",
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "Return a JSON object describing a book review with exactly these fields: title (non-empty string), rating (integer 1 to 5), recommend (boolean), pros (array of at least 1 string), cons (array of strings, may be empty). Respond with ONLY the JSON object, no other text."
      }
    ],
    "response_format": {
      "type": "json_object"
    },
    "max_tokens": 400
  },
  "check": {
    "type": "json_schema",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "rating",
        "recommend",
        "pros",
        "cons"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "recommend": {
          "type": "boolean"
        },
        "pros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
