# v02.override.env -- the 0.2.x engine's per-host overrides, sourced by serve-hauhaucs-v02.sh (V02_OVERRIDE_ENV).
# Example only; the real file stays on the serving host. Later lines win. Typical uses:
# Pin the engine release (a directory under ~/.local/share/vllm-releases):
# export V02_ROOT=/path/to/vllm-releases/<release-name>
# Rollbacks named in serve-hauhaucs-v02.sh:
# export V02_STACK=0            # the stacked engine path off (see the launcher's ROLLBACK note)
# export VLLM_TQ_GQA_CUDA=0     # the stock attention kernel instead of the prebuilt tq_gqa build
# export V02_ACCESS_LOG=1       # per-request access log back on
