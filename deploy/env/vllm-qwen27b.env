CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_HOME=/usr/local/cuda-12.8
CUDA_PATH=/usr/local/cuda-12.8
CUDA_VISIBLE_DEVICES=0,1
HOME=/home/kevin
PATH=/home/kevin/Desktop/vLLM-2080Ti-Definitive/.venv/bin:/usr/local/cuda-12.8/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin
TORCH_CUDA_ARCH_LIST=7.5
TORCH_EXTENSIONS_DIR=/home/kevin/Desktop/vLLM-2080Ti-Definitive/.deps/FlashQLA-SM70-SM75/.torch_extensions_vllm_flashqla_legacy
TORCHINDUCTOR_CACHE_DIR=/home/kevin/Desktop/vLLM-2080Ti-Definitive/torchinductor-cache
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
VLLM_SM75_SPEC_SYNC_MODE=safe
VLLM_TURBOQUANT_CONTINUATION_WORKSPACE_RESERVE_TOKENS=524288
VLLM_TURBOQUANT_CUDAGRAPH_SPEC_DECODE_SAFE=1
VLLM_TURBOQUANT_FLASHINFER_BACKEND=fa2
VLLM_TURBOQUANT_SPEC_CONTINUATION_DECODE_FASTPATH=1
VLLM_TURBOQUANT_USE_FLASHINFER_PREFILL=1
# 2026-07-17: DO NOT set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — it crashes
# worker init on this SM75 fork (conflicts with FULL_AND_PIECEWISE CUDA-graph capture:
# "RuntimeError: cancelled" during EngineCore init). The OOM is instead fixed by lowering
# --gpu-memory-utilization to 0.88 in serve-tqk8v4-fg.sh (more runtime headroom).
# 26.04 fix: pin gcc-13 for RUNTIME nvcc JIT (FlashInfer/torch cpp_extension).
# System default gcc is 15, which CUDA 12.8 nvcc rejects ("unsupported GNU version").
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
CUDAHOSTCXX=/usr/bin/g++-13
NVCC_CCBIN=/usr/bin/g++-13
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_ROPE_MAX_POSITION=655360
VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=1073741824
VLLM_MAMBA_ALIGN_RETAIN_MTP_CACHE_BLOCK=1
VLLM_TURBOQUANT_MAX_KV_SPLITS=128
VLLM_PREFIX_CACHE_USE_RETAINED_MTP_BLOCK=0
VLLM_TURBOQUANT_FLASHINFER_PREFILL_PLAN_CACHE_MAXSIZE=128
# 2026-09-07 07:25 (Fable) MITIGATION: the prefix-combine continuation branch is the home of the Xid-31 crash class (windows 891/892z/892w*)
VLLM_TURBOQUANT_CONTINUATION_PREFIX_COMBINE=off
VLLM_ALLOW_MAMBA_SPEC_FULL_CUDAGRAPH=0

# 2026-10-02 EF2 experiment arm B2: up to 3 consecutive short-first yield steps
VLLM_SCHED_SHORT_FIRST_RUN=3
# 2026-10-02 EF2 arm B3: step budget = one 3568-token block + 16 seqs x (1+MTP3) decode tokens
VLLM_MNBT=3632
VLLM_SCHED_PREFILL_SHARE=0.75
# 2026-10-02 LO2 ROLLBACK: fp16 mamba state (EF2 D1) removed -- 3 TQ prefill-portion Xids in 3.7h at 1856-token chunks (10:34/12:00/12:49) vs ~2/day before; see Capacity Tuning Backlog
#VLLM_SERVE_EXTRA_ARGS=--mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding
