SHIM_ALIASES_FILE=/home/kevin/.local/share/vllm-qwen27b/gateway-aliases.json
SHIM_TOKEN_BUDGET=auto
# --- 2026-08-13 tiny fast-lane + concurrency-aware wedge deadline + req logging ---
SHIM_TINY_TOKENS=1500
SHIM_TINY_EXTRA_LANES=1
