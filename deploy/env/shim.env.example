# Live gateway config for vllm-keepalive-shim. Mode 600 — the real file holds the DeepSeek key and is gitignored.
# This is the REDACTED example (2026-08-15: MTP-off/full-context era, thinking+repetition guards, exact-tokenize).
# Env for vllm-keepalive-shim.service (the capacity-routing gateway on :8000).
# Mode 600 — contains the DeepSeek key. Loaded via systemd EnvironmentFile.
SHIM_UPSTREAM=http://127.0.0.1:8001
SHIM_REMOTE_BASE=https://api.deepseek.com
SHIM_REMOTE_KEY=<your-deepseek-or-openai-compatible-key>
SHIM_REMOTE_MODEL=deepseek-v4-flash
SHIM_LOCAL_BUDGET=8
SHIM_BIG_TOKENS=25000
SHIM_OOM_BACKOFF_SECS=120
SHIM_LOCAL_WAIT_SECS=30.0
SHIM_MAX_LOCAL_TOKENS=256000
SHIM_TOKEN_BUDGET=500000
# --- 2026-08-13 tiny fast-lane + concurrency-aware wedge deadline + req logging ---
SHIM_TINY_TOKENS=1500
SHIM_TINY_EXTRA_LANES=1
SHIM_FT_CONCURRENCY_SCALE=1
SHIM_LOG_REQUESTS=True
SHIM_LOG_PREVIEW_CHARS=70
# --- 2026-08-13b: unstick Hermes — big-output overflow + capped failover deadline ---
SHIM_BIG_OUTPUT=66000
SHIM_FIRST_TOKEN_MAX=200.0
SHIM_BIG_PROMPT=240000
SHIM_LOCAL_MAX_OUT=8192
SHIM_PREFILL_TPS=1500.0
SHIM_FG_RESERVED=2
SHIM_BG_WAIT_SECS=5.0
SHIM_BG_NO_THINK=True
SHIM_NO_THINK_IPS={'10.0.1.10', '10.0.1.250'}
SHIM_FORCE_REMOTE=0
SHIM_PEAK_HOURS_UTC=1-4,6-10
SHIM_BG_MARKERS=['scheduled cron job']
SHIM_THINK_GUARD=1
SHIM_THINK_OFF_UNDER=2000
SHIM_THINK_LOW_UNDER=2000
SHIM_EMPTY_RETRY=1
SHIM_THINK_BUDGET_FRAC=0.5
SHIM_THINK_BUDGET_MIN=128
SHIM_THINK_BUDGET_MAX=4096
SHIM_REP_GUARD=1
SHIM_REP_MIN_PATTERN=8
SHIM_REP_MAX_PATTERN=64
SHIM_REP_MIN_COUNT=6

# LOCAL-FIRST overflow (L1, 2026-09-25): predictive reasons (big-prompt, perf, predicted,
# big-out, monster) go remote only when local is saturated (lanes full / token budget full /
# class already queued / mean admission wait over the last WINDOW >= QUEUE_WAIT). Explicit
# remote (estate-remote alias, route intent, forced window) and safety (local-down, failover)
# are unchanged. ROLLBACK: SHIM_LOCAL_FIRST=0 (dashboard-editable, no restart).
SHIM_LOCAL_FIRST=1
SHIM_LOCAL_FIRST_REASONS=big-prompt,perf,predicted,big-out,monster
SHIM_LOCAL_FIRST_QUEUE_WAIT_SECS=5
SHIM_LOCAL_FIRST_WAIT_WINDOW_SECS=60
# first-token cap for a >=BIG_PROMPT prompt on a LOCAL relay (a cold 100K prefill is ~62s)
SHIM_LOCAL_FIRST_FIRST_TOKEN_MAX=300
# >0: interactive requests with predicted local TTFT above this still go remote. Off: the
# 2026-09-25 data shows interactive local TTFT never breached 20s (p99 17.6s).
SHIM_LOCAL_FIRST_INTERACTIVE_TTFT_SECS=0

# Estate outcome brake: when accepted delivery is stalled or its alarm is unreadable,
# ordinary automatic overflow stays local after a small daily exploratory budget.
# Explicit estate-remote incident escalation remains under the shared $25 hard cap.
SHIM_OUTCOME_ALARM_PATH=/home/kevin/.local/share/estate-overseer/outcome-alarm.json
SHIM_STALLED_AUTO_OVERFLOW_CAP_USD=2.0
