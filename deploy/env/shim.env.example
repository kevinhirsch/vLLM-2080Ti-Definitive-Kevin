SHIM_FLOW_URGENT_SLACK_S=30.0

# --- 2026-10-03 Lane GW2 (L94/L95/L100). Rollback: delete this block (all keys default off). ---
# L100 Lane CR rollout step 1: chain-route telemetry only (no routing change). Warm priority stays OFF
# pending the 1 h A/B (watch remote share of warm turns, Halo TTFT p50/p95, engine preemptions == 0).
SHIM_CHAIN_TELEMETRY=1
SHIM_WARM_PRIORITY=0
# L95 long-empty-generation watchdog: SHADOW = log + count only, no behaviour change.
# Size it with deploy/bin/reasoning_watchdog_replay.py before switching to retry.
SHIM_REASONING_WATCHDOG=retry
SHIM_REASONING_BUDGET_TOKENS=8192
SHIM_REASONING_CHARS_PER_TOKEN=4.0
# 0 = explicit enable_thinking=true stays unbounded (old behaviour); N = sampler thinking_token_budget.
SHIM_THINK_BUDGET_EXPLICIT=0
# Engine-anchored cache credit, SHADOW: logs pm_credit_anchored; routing unchanged.
SHIM_CREDIT_ANCHOR=shadow
# L105 engine-reported cache credit: SHADOW (logs pm_credit_probe; 404 backoff until the engine has VLLM_FORK_PREFIX_PROBE=1).
SHIM_CREDIT_PROBE=shadow

# --- 2026-10-03 lane CFG: QoL interactive overflow SHADOW (logs qol_* telemetry, routing unchanged; main-approved). Takes effect when a gateway >= 3c0193a5fa starts. Rollback: delete this block.
SHIM_QOL_OVERFLOW=shadow
SHIM_CAPACITY_LIVE=1
SHIM_CONTEXT_LIVE=1
SHIM_MODELS_POLL_SECS=30.0
SHIM_TOKEN_BUDGET_FRAC=0.6630701740426593
SHIM_TOKEN_BUDGET_CEIL=680000
SHIM_LOCAL_MODALITIES=text
SHIM_REMOTE_VISION=0
SHIM_REPEAT_NOTE=1
SHIM_REPEAT_NOTE_MIN=3
SHIM_EST_TOOLCALLS=0
SHIM_WARM_PRIORITY_MIN_CREDIT=4096
SHIM_WARM_PRIORITY_MAX_COMPUTED=1700
SHIM_CREDIT_PROBE_TIMEOUT_S=0.3
SHIM_CREDIT_PROBE_MIN_TOKENS=4096
SHIM_LOCAL_FIRST_DERIVE=1
SHIM_EXPECTED_OUTPUT=1
SHIM_EXPECTED_OUTPUT_QUANTILE=0.95
SHIM_EXPECTED_OUTPUT_MIN_SAMPLES=20
SHIM_QOL_TTFT_S=15.0
SHIM_QOL_MIN_GAIN_S=5.0
SHIM_QOL_REASONS=perf,big-prompt,monster,predicted
SHIM_LOCAL_WORK_CLASS_PRIORITY=1

# 2026-10-20 (coordinator, Kevin): repetition retry on; remote revoked for the agent lanes
SHIM_REPETITION_RETRY=live
SHIM_LOCAL_ONLY_CLIENTS=openhands-coordinator,openhands-coordinator-deep,lane-medic
