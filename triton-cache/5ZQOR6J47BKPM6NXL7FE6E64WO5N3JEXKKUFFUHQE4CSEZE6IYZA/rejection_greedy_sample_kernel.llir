  %32 = getelementptr i32, ptr addrspace(1) %22, i64 %indvars.iv, !dbg !28
  %33 = tail call i32 asm sideeffect "mov.u32 $0, 0x0;\0A\09ld.global.b32 { $0 }, [ $1 + 0 ];", "=r,l"(ptr addrspace(1) %32) #2, !dbg !29
  %34 = getelementptr i64, ptr addrspace(1) %23, i64 %indvars.iv, !dbg !30
  %35 = tail call i64 asm sideeffect "mov.u64 $0, 0x0;\0A\09ld.global.b64 { $0 }, [ $1 + 0 ];", "=l,l"(ptr addrspace(1) %34) #2, !dbg !31
  %36 = trunc i64 %35 to i32, !dbg !32
  %37 = icmp ne i32 %33, %36, !dbg !33
  %38 = getelementptr i32, ptr addrspace(1) %27, i64 %indvars.iv, !dbg !34
